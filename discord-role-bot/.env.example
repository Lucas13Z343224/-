# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Ne partagez JAMAIS le fichier .env (il contient le token du bot).
DISCORD_TOKEN=collez_ici_le_token_du_bot
GUILD_ID=123456789012345678
ROLE_ID=123456789012345678
# Optionnel : pause entre deux ajouts, en secondes (défaut : 1)
DELAY_SECONDS=1
# Mode test : true = n'ajoute AUCUN rôle, affiche seulement ce qui serait fait.
# Mettez false pour ajouter les rôles pour de vrai.
DRY_RUN=true
# Nombre maximum de membres à traiter (0 = tous). Pratique pour un premier essai.
MAX_MEMBERS=5
