# Copie ce fichier en ".env" puis remplis chaque ligne (sans espaces autour du =).
# Le fichier .env est ignoré par Git : il reste uniquement sur ton ordinateur.

# Portail développeur Discord > ton application > General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Portail développeur Discord > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Identifiants du serveur (clic droit > "Copier l'identifiant", mode développeur activé)
DISCORD_GUILD_ID=
# Rôle donné quand on accepte le règlement
MEMBER_ROLE_ID=
# Rôle de l'équipe qui voit et gère les tickets
STAFF_ROLE_ID=
# Catégorie dans laquelle les salons ticket-xxx sont créés
TICKET_CATEGORY_ID=
# Salon où les transcriptions des tickets fermés sont envoyées
LOG_CHANNEL_ID=
