{
  "name": "nova-club-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot Discord du serveur NOVA CLUB | E-commerce (interactions HTTP sur Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secrets": "wrangler secret bulk .env",
    "register": "node --env-file=.env scripts/register-commands.js",
    "invite": "node --env-file=.env scripts/invite-url.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
